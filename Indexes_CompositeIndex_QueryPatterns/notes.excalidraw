      "isDeleted": false,
      "boundElements": [],
      "updated": 1781288907333,
      "link": null,
      "locked": false,
      "text": "Examples: \n               In the users table. - This users table has 1 M rows (10^6 rows) \n               Consider a column like gender / is_active \n               For gender => 5/10^6  \n               For is_active => 2/10^6 ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Examples: \n               In the users table. - This users table has 1 M rows (10^6 rows) \n               Consider a column like gender / is_active \n               For gender => 5/10^6  \n               For is_active => 2/10^6 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
