      "isDeleted": false,
      "boundElements": null,
      "updated": 1781361147011,
      "link": null,
      "locked": false,
      "text": "# Secondary index: non-clustered index\n     - Its a seperate index structure from the table\n     - It contains a copy of the indexed column and a pointer back to the main table\n     - u can have many of secondary indexes in our databases. \n     - secondary index is more like an indirect primary index. \n     ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Secondary index: non-clustered index\n     - Its a seperate index structure from the table\n     - It contains a copy of the indexed column and a pointer back to the main table\n     - u can have many of secondary indexes in our databases. \n     - secondary index is more like an indirect primary index. \n     ",
      "autoResize": true,
      "lineHeight": 1.25
    },
