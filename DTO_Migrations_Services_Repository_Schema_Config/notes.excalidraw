      "type": "text",
      "x": 306,
      "y": 2337,
      "width": 1119.039306640625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 1871641827,
      "version": 298,
      "versionNonce": 440915373,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779212800006,
      "link": null,
      "locked": false,
      "text": "1. Routing layer --> it decides based on the structure of a request that what are the set of functions or classes\nor structs resposible for handling each request \n\n2. Validation layer --> Responsible for doing request validation",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Routing layer --> it decides based on the structure of a request that what are the set of functions or classes\nor structs resposible for handling each request \n\n2. Validation layer --> Responsible for doing request validation",
      "autoResize": true,
      "lineHeight": 1.25
    },
