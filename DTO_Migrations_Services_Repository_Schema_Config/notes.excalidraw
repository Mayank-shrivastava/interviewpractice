    {
      "id": "XkO2USmwWnezpU19YncEw",
      "type": "text",
      "x": 314,
      "y": 1680,
      "width": 1095.8392333984375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 2066998125,
      "version": 515,
      "versionNonce": 612940589,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779212278847,
      "link": null,
      "locked": false,
      "text": "- Problem with MVC \n   - Too much simiplification of everything\n   - Due to this one piece of code will start doing more than one thing on a granule level   \n   - Tries to club view layer in the same backend code (Not being done in todays/modern system)\n   - Nowadays frontend codebase is kept apart from the server side code base and mvc doesnt talk about that\n   \n\n ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Problem with MVC \n   - Too much simiplification of everything\n   - Due to this one piece of code will start doing more than one thing on a granule level   \n   - Tries to club view layer in the same backend code (Not being done in todays/modern system)\n   - Nowadays frontend codebase is kept apart from the server side code base and mvc doesnt talk about that\n   \n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
