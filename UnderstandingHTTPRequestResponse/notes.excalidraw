    {
      "id": "i9k3SVmfNZtGwhgp8L6Bc",
      "type": "text",
      "x": 1176.7999877929688,
      "y": 2671.7999725341797,
      "width": 336.69976806640625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 635860766,
      "version": 110,
      "versionNonce": 55352926,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778961075990,
      "link": null,
      "locked": false,
      "text": "It's a numeric lable assigned \nuniquely to every device connected\nto computer network.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It's a numeric lable assigned \nuniquely to every device connected\nto computer network.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "F86aTvpqAO6kfSTnJ9FSe",
      "type": "text",
      "x": 390.3999938964844,
      "y": 2559.199966430664,
      "width": 260.2998046875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1209504542,
      "version": 75,
      "versionNonce": 109675266,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778961110544,
      "link": null,
      "locked": false,
      "text": "client needs to know the \nIP address of the machine",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "client needs to know the \nIP address of the machine",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BlAoodxaaXGmi-SE9-Jup",
      "type": "text",
      "x": 538.5999755859375,
      "y": 2718.199966430664,
      "width": 974.2398681640625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": null,
      "seed": 703115998,
      "version": 529,
      "versionNonce": 118999746,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778961281480,
      "link": null,
      "locked": false,
      "text": "3 things amazon needs to know to deliver your parcel\n1. Where to deliver -> IP address of the machine\n2. How to deliver  -> Network protocol\n3. Whom to deliver  -> on a machine various processes are runing client needs to know the address\nof specific process. Inside the machine if we want we can associate it with the PORT number. \n\n                                                                                                 unique logical number\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3 things amazon needs to know to deliver your parcel\n1. Where to deliver -> IP address of the machine\n2. How to deliver  -> Network protocol\n3. Whom to deliver  -> on a machine various processes are runing client needs to know the address\nof specific process. Inside the machine if we want we can associate it with the PORT number. \n\n                                                                                                 unique logical number\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
