      "link": null,
      "locked": false,
      "text": "How Elastic Search work algorithmically?\n\n- It works on the inverted index concept\n- tf/idf ratio\n- nlp related stuffs -> tokenisation etc\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How Elastic Search work algorithmically?\n\n- It works on the inverted index concept\n- tf/idf ratio\n- nlp related stuffs -> tokenisation etc\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
