    {
      "id": "h2C0yGNg3uie3ieAgoT-i",
      "type": "text",
      "x": 435.7999572753906,
      "y": 831.4000701904297,
      "width": 864.7393798828125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1717540398,
      "version": 723,
      "versionNonce": 1871475762,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782232530337,
      "link": null,
      "locked": false,
      "text": "# Let's start with prefix search: \n     - We find all the documents that start with a particular string / character\n     - Trie -> prefix tree data structure (this solution is space efficient)\n     - Sorted set of strings and apply binary search on it\n     - RDBMS -> index -> text -> arrange the text in the sorted order and now data is \nbeing stored in balanced BST\n     -  using the like query like '%h' \n\n# in case of suffix search sorted set array approach works\n   but we need to store the string in the reverse order",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Let's start with prefix search: \n     - We find all the documents that start with a particular string / character\n     - Trie -> prefix tree data structure (this solution is space efficient)\n     - Sorted set of strings and apply binary search on it\n     - RDBMS -> index -> text -> arrange the text in the sorted order and now data is \nbeing stored in balanced BST\n     -  using the like query like '%h' \n\n# in case of suffix search sorted set array approach works\n   but we need to store the string in the reverse order",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DoWFTzgChNEqNLucSHh87",
      "type": "text",
      "x": 429.7999572753906,
