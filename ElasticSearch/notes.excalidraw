      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Let's talk about substring search (we can't apply DNC directly using the above approach)\n   - query will look like '%hello%'\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
