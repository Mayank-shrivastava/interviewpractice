      "isDeleted": false,
      "boundElements": null,
      "updated": 1779638761497,
      "link": null,
      "locked": false,
      "text": "There is an order with id 3, which has \n3 products with id 1, 2 and 7\n\nThere is another order with id 5, which has \none product with id 2",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There is an order with id 3, which has \n3 products with id 1, 2 and 7\n\nThere is another order with id 5, which has \none product with id 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wjt9N4adiD_Xs2JgFfSaf",
      "type": "text",
      "x": 764.689826965332,
      "y": 2296.2000045776367,
      "width": 748.3595581054688,
      "height": 50,
      "angle": 0,
