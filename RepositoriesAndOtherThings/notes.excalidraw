      "index": "am",
      "roundness": null,
      "seed": 1888867169,
      "version": 84,
      "versionNonce": 432371969,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779638785990,
      "link": null,
      "locked": false,
      "text": "DELETE FROM order_products where order_id = 3 and product_id in (1, 2);\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DELETE FROM order_products where order_id = 3 and product_id in (1, 2);\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
