    {
      "id": "GNncZZomQhmf0xZbL-2vo",
      "type": "text",
      "x": 549.0897903442383,
      "y": 2864.599998474121,
      "width": 729.2996215820312,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
