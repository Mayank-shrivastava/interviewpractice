    {
      "id": "oE2hTMPKWcRFXIpsJBsWO",
      "type": "text",
      "x": 560.4898147583008,
      "y": 2493.2000045776367,
      "width": 931.059326171875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
