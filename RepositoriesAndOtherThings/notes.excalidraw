      "type": "text",
      "x": 536.489875793457,
      "y": 1575.0000381469727,
      "width": 874.2796020507812,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1895030799,
      "version": 680,
      "versionNonce": 17397089,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779638653444,
      "link": null,
      "locked": false,
      "text": "in a particular order, a user might include many products\none product might be a part of many orders\n\none product belongs to many orders -> many to many relationship\none order has many products \n\n\n# How to implement a many to many relationship\n     -> to facilatate the many to many relationship we need a join table or through table \n                                                                                     \n                product                           order                               order_products",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "in a particular order, a user might include many products\none product might be a part of many orders\n\none product belongs to many orders -> many to many relationship\none order has many products \n\n\n# How to implement a many to many relationship\n     -> to facilatate the many to many relationship we need a join table or through table \n                                                                                     \n                product                           order                               order_products",
      "autoResize": true,
      "lineHeight": 1.25
    },
