      "updated": 1779557526234,
      "link": null,
      "locked": false,
      "text": "@MappedSuperClass -> This annotation marks that we don't want to create a dedicated \ntable for a class, and its only used for inheritance purpose",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@MappedSuperClass -> This annotation marks that we don't want to create a dedicated \ntable for a class, and its only used for inheritance purpose",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "v-_0HvSuBiN-puKo-Cw0l",
      "type": "text",
      "x": 537.3999481201172,
      "y": 815.3999938964844,
      "width": 853.8994750976562,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 2031261263,
      "version": 32,
      "versionNonce": 1081146817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779558431562,
      "link": null,
      "locked": false,
      "text": "Be Careful with Lombok's @Data\nDo not use Lombok's @Data or @ToString annotation on entities with relationships. \n@Data overrides toString(), equals(), and hashCode() to print out all fields. \nIf Category calls toString() on its list of Products, and each Product calls toString() \non its Category, your app will get stuck in an infinite loop and crash with\n a StackOverflowError. Stick to @Getter and @Setter instead.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Be Careful with Lombok's @Data\nDo not use Lombok's @Data or @ToString annotation on entities with relationships. \n@Data overrides toString(), equals(), and hashCode() to print out all fields. \nIf Category calls toString() on its list of Products, and each Product calls toString() \non its Category, your app will get stuck in an infinite loop and crash with\n a StackOverflowError. Stick to @Getter and @Setter instead.",
      "autoResize": true,
      "lineHeight": 1.25
    },
