      "index": "au",
      "roundness": null,
      "seed": 818747361,
      "version": 394,
      "versionNonce": 525841999,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779647675556,
      "link": null,
      "locked": false,
      "text": "-> fetch the available products\n-> select * From products where deleted_at is null;\n-> Custom query like fetch all products where price is greater than 10,000\n-> select * from products where deleted_at is not null and price > 10000; \n\n\n- B+ tree -> logn (complexity) (Indexes)\n\n- Problem on nullable indexes  ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> fetch the available products\n-> select * From products where deleted_at is null;\n-> Custom query like fetch all products where price is greater than 10,000\n-> select * from products where deleted_at is not null and price > 10000; \n\n\n- B+ tree -> logn (complexity) (Indexes)\n\n- Problem on nullable indexes  ",
      "autoResize": true,
      "lineHeight": 1.25
    }
