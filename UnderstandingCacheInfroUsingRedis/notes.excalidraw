      "type": "text",
      "x": 501.00006103515625,
      "y": 990.9999809265137,
      "width": 810.4593505859375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
