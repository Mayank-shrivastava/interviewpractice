    },
    {
      "id": "Y8xN0IpC68zWAPxPwkG_b",
      "type": "text",
      "x": 631.4000854492188,
      "y": 324.1999931335449,
      "width": 479.9196472167969,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 551725988,
      "version": 305,
      "versionNonce": 310631964,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "rRBfdM4Fxzq9Isigd1cgY",
          "type": "arrow"
        }
      ],
      "updated": 1781630469775,
      "link": null,
      "locked": false,
      "text": "Considerations:\n     1. We are using RDBMS\n     2. Something like mysql/pgsql\n     3. We are running a single instance of this db\n     4. We are using a decently powered machine\n     5. Storage is about 50-64T",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Considerations:\n     1. We are using RDBMS\n     2. Something like mysql/pgsql\n     3. We are running a single instance of this db\n     4. We are using a decently powered machine\n     5. Storage is about 50-64T",
      "autoResize": true,
      "lineHeight": 1.25
    },
