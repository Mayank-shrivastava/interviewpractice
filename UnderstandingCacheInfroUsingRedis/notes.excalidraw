      "text": "Redis sorted set used in: Leader boards and rate limiters ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis sorted set used in: Leader boards and rate limiters ",
