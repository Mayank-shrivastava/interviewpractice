    },
    {
      "id": "AwdizAEotHRYKS3mRd_UO",
      "type": "text",
      "x": 761.9999237060547,
      "y": 7566.999971866608,
      "width": 441.9797058105469,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4e",
      "roundness": null,
      "seed": 359617132,
      "version": 202,
      "versionNonce": 1030576364,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781635573737,
      "link": null,
      "locked": false,
      "text": "Redis supports: \n   - Streams\n   - Bit map\n   - Time series db (Not being used generally)\n   -  CDC (Supports) Change data capture\n   ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis supports: \n   - Streams\n   - Bit map\n   - Time series db (Not being used generally)\n   -  CDC (Supports) Change data capture\n   ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DF__F1vL3ZgkHpBPB8SXV",
      "type": "text",
      "x": 462.5999298095703,
      "y": 7764.800005435944,
      "width": 757.6994018554688,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4f",
      "roundness": null,
      "seed": 1240695532,
      "version": 319,
      "versionNonce": 200481644,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781636344551,
      "link": null,
      "locked": false,
      "text": "- When to not cache\n   - Extremely consistency sensitive data -> don't make redis source of truth\n   - Heavy writes by less reads\n   - If we have to store large blobs data",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- When to not cache\n   - Extremely consistency sensitive data -> don't make redis source of truth\n   - Heavy writes by less reads\n   - If we have to store large blobs data",
      "autoResize": true,
      "lineHeight": 1.25
    },
