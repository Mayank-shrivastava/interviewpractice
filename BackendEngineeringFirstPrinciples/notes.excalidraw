      "seed": 2031804519,
      "version": 892,
      "versionNonce": 519017031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777917414570,
      "link": null,
      "locked": false,
      "text": "- We are building a reminder service\n- People are going to tell us, what they want us to remember\n- We have a responsibility to remind the users as well \n- In nutshell we have to do two things, remember on behalf of users \n       and remind them as well about the event\n\n\n- we will give our phone number to the users and take users phone number\nand whenever user want us to remember something can SMS us or call us.\n- when we have to remind our users, we can send them an sms, whatsapp, call.\n\n\n\nusers\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- We are building a reminder service\n- People are going to tell us, what they want us to remember\n- We have a responsibility to remind the users as well \n- In nutshell we have to do two things, remember on behalf of users \n       and remind them as well about the event\n\n\n- we will give our phone number to the users and take users phone number\nand whenever user want us to remember something can SMS us or call us.\n- when we have to remind our users, we can send them an sms, whatsapp, call.\n\n\n\nusers\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
