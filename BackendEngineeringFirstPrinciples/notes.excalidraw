    {
      "id": "C8TsqcZMU2fbWTuRsyFWR",
      "type": "text",
      "x": 458.80010986328125,
      "y": 168.59991455078125,
      "width": 756.139404296875,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
