    {
      "id": "EIUI6DLE74F9UUE5NH3Ou",
      "type": "text",
      "x": 418.199951171875,
      "y": 1763.1999816894531,
      "width": 986.8392333984375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 375218708,
      "version": 920,
      "versionNonce": 1345377300,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778931413864,
      "link": null,
      "locked": false,
      "text": "what is castling in chess? \n  - castle is the not property of all the pieces\n  - it is only triggered by the king\n  - rook is not able to triggered it it just swap the position with king in castle\n  - so for all the methods we are gonna throw exception \n  \n  - similar things happens with the move, because not everytime we can move for some moves or say \n    coordinate we need to throw InvalidMoveException. \n  - in case of pawn class if someone gave us X coordinate which is behind us, it's an illegal argument. \n  - so exceptions definition are also of two types or multi-type based on the scenerios. \n \n  - The way we are designed classes is forcing us to implement several methods. \n\n      ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "what is castling in chess? \n  - castle is the not property of all the pieces\n  - it is only triggered by the king\n  - rook is not able to triggered it it just swap the position with king in castle\n  - so for all the methods we are gonna throw exception \n  \n  - similar things happens with the move, because not everytime we can move for some moves or say \n    coordinate we need to throw InvalidMoveException. \n  - in case of pawn class if someone gave us X coordinate which is behind us, it's an illegal argument. \n  - so exceptions definition are also of two types or multi-type based on the scenerios. \n \n  - The way we are designed classes is forcing us to implement several methods. \n\n      ",
      "autoResize": true,
      "lineHeight": 1.25
    },
