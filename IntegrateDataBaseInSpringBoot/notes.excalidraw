      "isDeleted": false,
      "boundElements": null,
      "updated": 1779478877521,
      "link": null,
      "locked": false,
      "text": "application.yml -> configuration for connecting db\n\nspring:\n    application:\n        name: FakeCommerce\n    datasource:\n        url: jdbc:mysql://localhost:3306/fakecommerce\n        username: root\n        password: {$PASSWORD}\n        driver-class-name: com.mysql.cj.jdbc.Driver\n    jpa:\n        show-sql: true\n        hibernate:\n            ddl-auto: update",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "application.yml -> configuration for connecting db\n\nspring:\n    application:\n        name: FakeCommerce\n    datasource:\n        url: jdbc:mysql://localhost:3306/fakecommerce\n        username: root\n        password: {$PASSWORD}\n        driver-class-name: com.mysql.cj.jdbc.Driver\n    jpa:\n        show-sql: true\n        hibernate:\n            ddl-auto: update",
      "autoResize": true,
      "lineHeight": 1.25
    }
